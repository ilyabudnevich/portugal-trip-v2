# Copy this file to .env and fill in the real values from your Supabase
# project: Project Settings -> API. The .env file is gitignored.
#
# Vite only exposes VITE_-prefixed variables to browser code, and it reads .env
# at server start — restart `npm run dev` after changing it.
#
# The anon key is safe to ship in a browser bundle; the service_role key is not.
# Never put the service_role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
